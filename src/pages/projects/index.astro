---
import { ArrowUpRight } from "lucide-astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectRow from "../../components/ProjectRow.astro";
import { projects } from "../../data/projects";
import { site } from "../../site";
---

<BaseLayout
  title="项目"
  description="吴帅参与过的知识图谱导学、个性化在线教育与智能投放系统项目。"
>
  <header class="page-intro container">
    <div class="page-intro-inner">
      <h1>项目与系统</h1>
      <p class="page-intro-description">
        这里整理做过的系统项目与研究，包括知识图谱导学、个性化在线教育和广告投放优化。
      </p>
    </div>
  </header>

  <div class="container projects-page">
    {projects.map((project) => <ProjectRow project={project} />)}
    <div class="project-note">
      <p>
        更完整的架构、关键判断和项目复盘会陆续整理成文章。代码与公开资料可以在 GitHub 查看。
      </p>
      <a class="section-link" href={site.github} target="_blank" rel="noopener noreferrer">
        GitHub
        <ArrowUpRight size={15} aria-hidden="true" />
      </a>
    </div>
  </div>
</BaseLayout>
