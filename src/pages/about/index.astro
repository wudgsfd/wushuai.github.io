---
import { Github, Rss } from "lucide-astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../site";
import { withBase } from "../../utils";
---

<BaseLayout
  title="关于"
  description="吴帅，安徽信息工程学院教师，研究方向为个性化推荐、隐式反馈建模、学习者建模与知识图谱。"
>
  <div class="container about-layout">
    <aside class="about-aside" aria-label="关于页面目录">
      <nav>
        <a href="#profile">个人介绍</a>
        <a href="#timeline">教育与经历</a>
        <a href="#research">研究论文</a>
        <a href="#credentials">专利与软著</a>
        <a href="#honors">荣誉与竞赛</a>
        <a href="#contact">联系</a>
      </nav>
    </aside>

    <div>
      <section id="profile" class="about-section">
        <h1>个人介绍 <span>Profile</span></h1>
        <p>
          研究和工程工作围绕推荐系统展开：从个性化推荐中的隐式反馈建模，到融合特征提取与注意力机制的自适应学习推荐。工程侧做过知识图谱导学平台与在线教育系统，另有若干推荐算法相关发明专利。
        </p>
        <p>
          写作主要记录三类事情：课堂上真实发生的教学判断，职业选择中的取舍，以及系统项目从方案到落地时那些不容易被写进简历的部分。
        </p>
        <div class="focus-grid">
          <div><span>RESEARCH 01</span><strong>个性化推荐</strong></div>
          <div><span>RESEARCH 02</span><strong>学习者建模</strong></div>
          <div><span>ENGINEERING</span><strong>知识图谱系统</strong></div>
        </div>
      </section>

      <section id="timeline" class="about-section">
        <h2>教育与经历 <span>Timeline</span></h2>
        <div class="timeline">
          <div class="timeline-item">
            <time>2023.09 — 2026.06</time>
            <div><strong>江苏海洋大学</strong><span>模式识别与智能系统 · 硕士</span></div>
          </div>
          <div class="timeline-item">
            <time>2019.09 — 2023.06</time>
            <div><strong>安徽大学江淮学院</strong><span>计算机科学与技术 · 本科</span></div>
          </div>
          <div class="timeline-item">
            <time>2023.07 — 2023.09</time>
            <div><strong>合肥若果科技有限公司</strong><span>智能制造见习研究员 · 实习</span></div>
          </div>
        </div>
      </section>

      <section id="research" class="about-section">
        <h2>研究论文 <span>Publications</span></h2>
        <ol class="publication-list">
          <li>
            <div>
              <h3>Modeling and application of implicit feedback in personalized recommender systems</h3>
              <p>Electronic Research Archive, 2025, 33(2): 1185 · 中科院四区</p>
            </div>
          </li>
          <li>
            <div>
              <h3>Enhancing Personalized Learning Recommendations: DynLearn-Adapt Model Integrating Feature Extraction and Attention</h3>
              <p>IEEE Transactions on Consumer Electronics · 中科院二区（Major Revision）</p>
            </div>
          </li>
          <li>
            <div>
              <h3>Fake News Detection Based on Multi-Perspective Differential Feature Fusion</h3>
              <p>IEEJ Transactions on Electrical and Electronic Engineering, 2026 · 中科院四区</p>
            </div>
          </li>
          <li>
            <div>
              <h3>A study of a personalized library recommendation algorithm</h3>
              <p>Journal of Computational Methods in Sciences and Engineering, 2025, 25(5): 3889–3901 · 中科院四区</p>
            </div>
          </li>
        </ol>
      </section>

      <section id="credentials" class="about-section">
        <h2>专利与软件著作权 <span>Patents</span></h2>
        <div class="credential-grid">
          <div class="credential-block">
            <h3>发明专利 · 5 项</h3>
            <ul>
              <li>一种结合深度学习与信息融合的资源推荐方法（实审）</li>
              <li>一种基于深度学习的改进 NCF 推荐方法（实审）</li>
              <li>一种基于 Wide &amp; Deep 模型的图书馆推荐方法（实审）</li>
              <li>一种基于特征提取与注意力机制的个性化学习推荐方法（申请）</li>
              <li>一种基于强化学习的广告投放实时优化方法及系统（申请）</li>
            </ul>
          </div>
          <div class="credential-block">
            <h3>软件著作权 · 4 项</h3>
            <ul>
              <li>基于人工智能的在线大数据教育系统 V1.0</li>
              <li>基于知识图谱构建的智能导学微信小程序 V1.0</li>
              <li>基于知识图谱构建的智能导学平台 V1.0</li>
              <li>基于个性化推荐的在线教育智能导学平台 V1.0</li>
            </ul>
          </div>
        </div>
        <p>参与国家自然科学基金项目申报书撰写。</p>
      </section>

      <section id="honors" class="about-section">
        <h2>荣誉与竞赛 <span>Honors</span></h2>
        <dl class="honor-groups">
          <div>
            <dt>省级</dt>
            <dd>安徽省优秀毕业生 · 挑战杯安徽省大学生创业计划竞赛银奖 · 全国大学生数学建模竞赛安徽省二等奖 · 数字媒体科技作品及创意竞赛江苏省三等奖 · 中国大学生服务外包创新创业大赛江苏省三等奖</dd>
          </div>
          <div>
            <dt>校级</dt>
            <dd>学业一等奖学金 · 优秀研究生 · 社会活动先进个人 · 优秀学生干部 · 优秀团学干部</dd>
          </div>
          <div>
            <dt>其他</dt>
            <dd>英语六级（CET-6）</dd>
          </div>
        </dl>
      </section>

      <section id="contact" class="about-section">
        <h2>联系 <span>Contact</span></h2>
        <p>项目交流、内容纠错或工作联系，可以通过 GitHub 找到我。</p>
        <div class="hero-actions">
          <a class="button button-primary" href={site.github} target="_blank" rel="noopener noreferrer">
            <Github size={17} aria-hidden="true" />
            GitHub
          </a>
          <a class="button button-secondary" href={withBase("/feed.xml")}>
            <Rss size={16} aria-hidden="true" />
            订阅更新
          </a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
