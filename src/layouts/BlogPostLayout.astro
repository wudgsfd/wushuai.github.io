---
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import { ArrowLeft, ArrowRight, Clock3 } from "lucide-astro";
import BaseLayout from "./BaseLayout.astro";
import { formatDate, postPath, readingTime, withBase } from "../utils";
import { site } from "../site";

type Props = {
  post: CollectionEntry<"blog">;
  previous?: CollectionEntry<"blog">;
  next?: CollectionEntry<"blog">;
  headings: MarkdownHeading[];
};

const { post, previous, next, headings } = Astro.props;
const minutes = readingTime(post.body);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const canonical = new URL(postPath(post), Astro.site).toString();

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  mainEntityOfPage: canonical,
  author: {
    "@type": "Person",
    name: site.title,
    url: new URL(withBase("/"), Astro.site).toString(),
  },
  publisher: {
    "@type": "Person",
    name: site.title,
  },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  publishedTime={post.data.date.toISOString()}
  structuredData={articleJsonLd}
>
  <div class="reading-progress" aria-hidden="true"></div>
  <article class="article-shell">
    <header class="article-header container">
      <a class="back-link" href={withBase("/writing/")}>
        <ArrowLeft size={15} aria-hidden="true" />
        全部文章
      </a>
      <div class="article-kicker">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span class="dot" aria-hidden="true"></span>
        <span class="inline-icon"><Clock3 size={14} aria-hidden="true" /> {minutes} 分钟</span>
      </div>
      <h1>{post.data.title}</h1>
      <p class="article-lead">{post.data.description}</p>
      <ul class="tag-list article-tags" aria-label="文章标签">
        {post.data.tags.map((tag) => (
          <li><a href={`${withBase("/writing/")}?tag=${encodeURIComponent(tag)}`}>{tag}</a></li>
        ))}
      </ul>
    </header>

    <div class="article-grid container">
      {
        toc.length > 0 && (
          <aside class="article-toc" aria-label="文章目录">
            <p>本文目录</p>
            <nav>
              {toc.map((heading) => (
                <a class:list={[{ "is-sub": heading.depth === 3 }]} href={`#${heading.slug}`}>
                  {heading.text}
                </a>
              ))}
            </nav>
          </aside>
        )
      }
      <div class="article-content">
        <div class="prose">
          <slot />
        </div>

        <section class="author-note" aria-label="作者简介">
          <img src={withBase("/assets/avatar.jpg")} alt="" width="64" height="64" loading="lazy" />
          <div>
            <p class="author-note-label">Written by</p>
            <h2>{site.title}</h2>
            <p>记录教学现场、推荐系统与系统项目，也写下一个青年教师的职业选择和工作复盘。</p>
          </div>
        </section>
      </div>
    </div>

    {(previous || next) && (
      <nav class="article-pagination container" aria-label="文章翻页">
        {previous ? (
          <a href={postPath(previous)}>
            <span><ArrowLeft size={14} aria-hidden="true" /> 上一篇</span>
            <strong>{previous.data.title}</strong>
          </a>
        ) : (
          <span />
        )}
        {next ? (
          <a class="pagination-next" href={postPath(next)}>
            <span>下一篇 <ArrowRight size={14} aria-hidden="true" /></span>
            <strong>{next.data.title}</strong>
          </a>
        ) : (
          <span />
        )}
      </nav>
    )}
  </article>
</BaseLayout>

<script>
  const progress = document.querySelector<HTMLElement>(".reading-progress");
  const article = document.querySelector<HTMLElement>(".article-content");

  if (progress && article) {
    const updateProgress = () => {
      const start = article.offsetTop;
      const distance = article.offsetHeight - window.innerHeight;
      const ratio = distance > 0 ? (window.scrollY - start) / distance : 0;
      progress.style.transform = `scaleX(${Math.min(1, Math.max(0, ratio))})`;
    };

    updateProgress();
    window.addEventListener("scroll", updateProgress, { passive: true });
    window.addEventListener("resize", updateProgress);
  }
</script>
