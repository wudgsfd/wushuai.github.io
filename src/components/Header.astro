---
import { Github, Rss } from "lucide-astro";
import { navigation, site } from "../site";
import { withBase } from "../utils";

const { pathname } = Astro.url;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const relativePath = pathname.startsWith(base)
  ? pathname.slice(base.length) || "/"
  : pathname;

const isActive = (href: string) => {
  if (href === "/") return relativePath === "/";
  if (href === "/writing/") {
    return relativePath.startsWith("/writing/") || relativePath.startsWith("/posts/");
  }
  return relativePath.startsWith(href);
};
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={withBase("/")} aria-label="返回吴帅的首页">
      <span class="brand-mark" aria-hidden="true">吴</span>
      <span class="brand-copy">
        <strong>{site.title}</strong>
        <small>{site.englishName}</small>
      </span>
    </a>

    <nav class="main-nav" aria-label="主导航">
      {
        navigation.map((item) => (
          <a
            href={withBase(item.href)}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <a
        class="icon-link"
        href={site.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="访问 GitHub"
        title="GitHub"
      >
        <Github size={17} strokeWidth={1.8} />
      </a>
      <a
        class="icon-link feed-link"
        href={withBase("/feed.xml")}
        aria-label="订阅 RSS"
        title="RSS"
      >
        <Rss size={16} strokeWidth={1.8} />
      </a>
    </div>
  </div>
</header>
